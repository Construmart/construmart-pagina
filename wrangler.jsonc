{
  "name": "construmart-pagina",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BANDEJA", "class_name": "Bandeja" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bandeja"] }]
}
